        <owl:annotatedTarget xml:lang="en">basal fold of the insect wing</owl:annotatedTarget>
        <rdfs:comment xml:lang="en">Modified 2023-01-21: specifying insect wing fold.
jgiron https://orcid.org/0000-0002-0851-6883</rdfs:comment>
    </owl:Axiom>
    


