        <owl:annotatedTarget xml:lang="en">The region of cuticle on the lateral region of the insect thorax that is attached to the notum and the sternum and is attached to the coxae by skeletal muscle tissue and the basal coxal conjunctiva.</owl:annotatedTarget>
        <dc:contributor>jgiron https://orcid.org/0000-0002-0851-6883</dc:contributor>
        <oboInOwl1:creation_date>2021-04-05</oboInOwl1:creation_date>
