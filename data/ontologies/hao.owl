    <!-- http://purl.obolibrary.org/obo/AISM_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AISM_0000136"/>
