    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/hao.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/hao/releases/2026-02-12/hao.owl"/>
        <dcterms:contributor>Davide Dal Pos (DDP) https://orcid.org/0000-0002-9122-934X</dcterms:contributor>
        <dcterms:contributor>István Mikó (IM) https://orcid.org/0000-0003-2938-9075</dcterms:contributor>
