    <!-- http://purl.obolibrary.org/obo/AISM_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AISM_0000029"/>
