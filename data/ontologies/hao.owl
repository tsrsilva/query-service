        <owl:annotatedTarget xml:lang="en">The conjunctiva of the insect head that is connected to the oral foraminal conjunctiva and to the distal margin of the labrum.</owl:annotatedTarget>
        <dc:contributor>jgiron https://orcid.org/0000-0002-0851-6883</dc:contributor>
