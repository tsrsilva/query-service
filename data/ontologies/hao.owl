        <rdfs:subClassOf rdf:nodeID="genid1943"/>
        <rdfs:subClassOf rdf:nodeID="genid1945"/>
        <rdfs:subClassOf rdf:nodeID="genid1951"/>
        <obo:IAO_0000115 xml:lang="en">The solid, paired, branching cuticular invagination of the head capsule that is attached to the antenna and the mouthparts via muscles.</obo:IAO_0000115>
        <obo:IAO_0000232 xml:lang="en">The paired apophysis that connects the posterior (ventral in prognathous head) and anterior (dorsal in prognathous head) walls of the head capsule and serves as site of isertion of atennal and mouthpart muscles.</obo:IAO_0000232>
        <rdfs:label xml:lang="en">tentorium</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1941">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
