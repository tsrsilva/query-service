        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000232"/>
        <owl:annotatedTarget xml:lang="en">The paired apophysis that connects the posterior (ventral in prognathous head) and anterior (dorsal in prognathous head) walls of the head capsule and serves as site of isertion of atennal and mouthpart muscles.</owl:annotatedTarget>
        <dc:contributor>imiko https://orcid.org/0000-0003-2938-9075</dc:contributor>
