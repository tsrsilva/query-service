    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AISM_0000073"/>
        <rdfs:subClassOf rdf:nodeID="genid766"/>
