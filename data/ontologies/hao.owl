        <dcterms:contributor>Sergei Tarasov (STarasov) https://orcid.org/0000-0001-5237-2330</dcterms:contributor>
        <dcterms:description xml:lang="en">The Hymenoptera Anatomy Ontology (HAO) contains terms used to describe Hymenoptera anatomy phenotypes.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">Hymenoptera Anatomy Ontology</dcterms:title>
        <owl:versionInfo>2026-02-12</owl:versionInfo>
    </owl:Ontology>
    


