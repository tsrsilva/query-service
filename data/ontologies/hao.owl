        <rdfs:subClassOf rdf:nodeID="genid1822"/>
        <obo:IAO_0000115 xml:lang="en">The conjunctiva that encircles the coxa and connects it to the ventral and lateral thoracic regions.</obo:IAO_0000115>
        <obo:IAO_0000232 xml:lang="en">These conjunctivae can be used as stable reference points in insects that poseess legs, and can be used to define sclerites on the lateral side of the thorax.</obo:IAO_0000232>
        <rdfs:label xml:lang="en">basal coxal conjunctiva</rdfs:label>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1802">
